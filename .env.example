# AgentKit — Variables de entorno
# Copia este archivo como .env y llena tus datos:
#   cp .env.example .env
#
# Tu asistente de IA (Devin, etc.) te ayuda a llenar estos valores durante el setup.
# NUNCA subas el archivo .env a GitHub.

# ── Google Gemini ──────────────────────────────────────────
# Obtener gratis (sin tarjeta) en: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Modelo de Gemini. Default: gemini-3.5-flash-lite
# Nota: gemini-2.5-flash-lite fue descontinuado por Google para cuentas nuevas
# (devuelve 404 "no longer available to new users"). Si tu cuenta si tiene acceso,
# podes usarlo, pero para cuentas nuevas usa la serie 3.5.
#   gemini-3.5-pro         el mas capaz, sin capa gratuita
#   gemini-3.5-flash       gratis, cuota diaria muy baja (20 req/dia)
#   gemini-3.5-flash-lite  el balanceado (default) — gratis, limites mas generosos
GEMINI_MODEL=gemini-3.5-flash-lite

# Opcional. Tope de tokens por respuesta, default 1024. Ojo: en los modelos 2.5 el
# razonamiento interno ("thinking") tambien cuenta contra este tope.
# GEMINI_MAX_TOKENS=1024

# ── OpenRouter (respaldo cuando se agota la cuota gratuita de Gemini) ──
# Opcional. Si esta configurada, el agente la usa automaticamente cuando Gemini
# devuelve 429 (limite de cuota alcanzado), para no dejar al cliente sin respuesta.
# Conseguir key gratis en: https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Modelo de respaldo. Default: openrouter/free (router que elige automaticamente
# entre todos los modelos gratuitos disponibles en ese momento; mas confiable que
# fijar un modelo especifico, que puede saturarse o dejar de estar disponible).
# OPENROUTER_MODEL=openrouter/free

# ── Proveedor de WhatsApp ──────────────────────────────────
# Opciones: zernio | meta
WHATSAPP_PROVIDER=

# ── Zernio (si WHATSAPP_PROVIDER=zernio) ───────────────────
# Crear cuenta y conectar WhatsApp en: https://zernio.com
# La API key se genera en Settings -> API Keys (empieza con "sk_")
ZERNIO_API_KEY=
# El webhook secret lo inventas tu. Sirve para verificar que los
# mensajes vienen de Zernio y no de cualquiera que sepa tu URL.
ZERNIO_WEBHOOK_SECRET=
# Opcional: solo se usa para chequear la conexion al arrancar.
# Para responder, el account id sale del propio webhook.
ZERNIO_ACCOUNT_ID=
# Opcional: solo si necesitas apuntar a otra URL. Dejala comentada para usar
# la de siempre, https://zernio.com/api/v1
# ZERNIO_BASE_URL=

# ── Meta Cloud API (si WHATSAPP_PROVIDER=meta) ─────────────
# Configurar en: https://developers.facebook.com
# META_ACCESS_TOKEN=
# META_PHONE_NUMBER_ID=
# META_VERIFY_TOKEN=agentkit-verify
# META_APP_SECRET=
# META_API_VERSION=v25.0

# ── Servidor ───────────────────────────────────────────────
PORT=8000
ENVIRONMENT=development

# ── Base de datos ──────────────────────────────────────────
# Local (SQLite):
DATABASE_URL=sqlite+aiosqlite:///./agentkit.db
# Produccion (PostgreSQL en Railway):
# DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/dbname
